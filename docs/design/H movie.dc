<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Movie · Popcorn Matinee</title>
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lilita+One&amp;family=Work+Sans:wght@400;500;600;700&amp;family=IBM+Plex+Mono:wght@500;600&amp;display=swap">
<style>
body{margin:0}
a{color:#2A1A12}a:hover{color:#000000}
svg.i{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.lil{font-family:'Lilita One',sans-serif;font-weight:400}
.mono{font-family:'IBM Plex Mono',monospace}
.sticker{border:2px solid #2A1A12;border-radius:16px;background:#FFFFFF;box-shadow:3px 3px 0 #2A1A12}
.day{flex:1;height:52px;border:2px solid #2A1A12;border-radius:12px;background:#FFFFFF;color:#2A1A12;font:400 12px 'Lilita One',sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer}
.tok{font:600 13px 'IBM Plex Mono',monospace;padding:5px 10px;border-radius:999px;background:#FFD447;border:1.5px solid #2A1A12;color:#2A1A12;text-decoration:none}
.tab{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;text-decoration:none;font:400 12px 'Lilita One',sans-serif;letter-spacing:0.02em;color:#6B5A4E}
</style>
</helmet>
<div style="width: 390px; height: 844px; position: relative; overflow: hidden; background: #FFFBF0; color: #2A1A12; font-family: 'Work Sans', sans-serif; box-sizing: border-box">
  <header style="background: repeating-linear-gradient(90deg, {{accent}} 0 22px, #FFFFFF 22px 44px); border-bottom: 3px solid #2A1A12; padding: 10px 12px 14px 10px; display: flex; align-items: center; gap: 8px">
    <a href="H-Home.dc.html" aria-label="Back" class="sticker" style="width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex: none; box-shadow: 2px 2px 0 #2A1A12"><svg class="i" viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"></path></svg></a>
    <div class="sticker" style="flex: 1; min-width: 0; padding: 8px 12px">
      <h1 class="lil" style="margin: 0; font-size: 26px; line-height: 1; color: {{accent}}">Harbor Lights</h1>
      <div style="font-size: 12px; font-weight: 600; margin-top: 3px">2h 14m · R · IMAX, Dolby, 70mm</div>
    </div>
  </header>

  <div style="display: flex; gap: 6px; padding: 14px 18px 0">
    <sc-for list="{{days}}" as="d" hint-placeholder-count="5">
      <button class="day" style="{{d.style}}"><span>{{d.dow}}</span><span class="mono" style="font-size: 15px; font-weight: 600">{{d.num}}</span></button>
    </sc-for>
  </div>

  <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 12px 18px 0; font-size: 12px; font-weight: 600; color: #6B5A4E">
    <span>Next showing you can make, first</span>
    <a href="H-Prefs.dc.html" style="color: {{accent}}">Theaters &amp; filters</a>
  </div>

  <div style="display: flex; flex-direction: column; gap: 12px; padding: 12px 18px 90px">
    <sc-for list="{{theaters}}" as="t" hint-placeholder-count="3">
      <div class="sticker" style="padding: 12px 14px; display: flex; flex-direction: column; gap: 8px">
        <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 8px">
          <a href="B-Theater.dc.html" style="font-size: 14px; font-weight: 700; text-decoration: none">{{t.name}}</a>
          <span style="font-size: 11px; font-weight: 700; color: #6B5A4E; flex: none">{{t.meta}}</span>
        </div>
        <a href="H-Movie.dc.html" style="display: flex; align-items: center; gap: 12px; text-decoration: none">
          <span class="lil" style="font-size: 34px; line-height: 1; color: {{accent}}">{{t.next}}</span>
          <span style="display: flex; flex-direction: column; gap: 1px">
            <span style="font-size: 13px; font-weight: 700">{{t.fmt}}</span>
            <span style="font-size: 12px; color: #6B5A4E">{{t.wait}}</span>
          </span>
        </a>
        <sc-if value="{{t.hasLater}}" hint-placeholder-val="{{ true }}">
          <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap">
            <span style="font-size: 12px; font-weight: 700; color: #6B5A4E">Later:</span>
            <sc-for list="{{t.later}}" as="s" hint-placeholder-count="2"><a class="tok" href="H-Movie.dc.html">{{s}}</a></sc-for>
          </div>
        </sc-if>
        <sc-if value="{{t.hidden}}" hint-placeholder-val="{{ false }}"><div style="font-size: 12px; color: #6B5A4E; border-top: 2px dashed #E3D3B5; padding-top: 8px">{{t.hidden}}</div></sc-if>
      </div>
    </sc-for>
  </div>

  <nav aria-label="Main" style="position: absolute; left: 0; right: 0; bottom: 0; height: 74px; background: #FFFFFF; border-top: 3px solid #2A1A12; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); padding-bottom: 8px; box-sizing: border-box">
    <a class="tab" href="H-Home.dc.html"><svg class="i" viewBox="0 0 24 24"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"></path></svg><span>Home</span></a>
    <a class="tab" href="H-Movie.dc.html" style="color: {{accent}}"><svg class="i" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M7 4v16M17 4v16M3 9h4M3 15h4M17 9h4M17 15h4"></path></svg><span>Movies</span></a>
    <a class="tab" href="B-Theater.dc.html"><svg class="i" viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg><span>Theaters</span></a>
    <a class="tab" href="B-Screenings.dc.html"><svg class="i" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"></circle><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M18 14a6 6 0 0 1 3.5 6"></path></svg><span>Screenings</span></a>
  </nav>
</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props='{"accent":{"editor":"color","default":"#D1301F","options":["#D1301F","#2457C5","#1E7F55"]},"$preview":{"width":390,"height":844}}'>
class Component extends DCLogic {
  renderVals() {
    const accent = this.props.accent ?? '#D1301F';
    const sel = 'background: ' + accent + '; color: #FFFFFF; box-shadow: 2px 2px 0 #2A1A12';
    const days = [['Mon', '5'], ['Tue', '6'], ['Wed', '7'], ['Thu', '8'], ['Fri', '9']].map((d, i) => ({ dow: d[0], num: d[1], style: i === 0 ? sel : '' }));
    const th = (name, meta, next, fmt, wait, later, hidden) => ({ name, meta, next, fmt, wait, later, hasLater: later.length > 0, hidden });
    return {
      accent,
      days,
      theaters: [
        th('AMC Lincoln Square 13', 'AMC · 3.1 mi', '3:45', 'IMAX · A-List', 'Starts in 1h 05m', ['7:00 Dolby', '10:15'], ''),
        th('Alamo Lower Manhattan', 'Alamo · 5.2 mi', '6:30', 'Standard', 'Starts in 3h 50m', ['9:45'], ''),
        th('Museum of the Moving Image', 'Local · 0.5 mi', '7:30', '70mm', 'Starts in 4h 50m', [], ''),
        th('Regal UA Kaufman Astoria', 'Regal · 0.6 mi', '7:40', 'RPX', 'Starts in 5h', [], '4:20 hidden: only wheelchair and companion seats left')
      ]
    };
  }
}
</script>
</body>
</html>
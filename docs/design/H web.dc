<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Web · Popcorn Matinee</title>
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lilita+One&amp;family=Work+Sans:wght@400;500;600;700&amp;family=IBM+Plex+Mono:wght@500;600&amp;display=swap">
<style>
body{margin:0;background:#FFFBF0}
a{color:#2A1A12}a:hover{color:#000000}
svg.s{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.lil{font-family:'Lilita One',sans-serif;font-weight:400}
.mono{font-family:'IBM Plex Mono',monospace}
.sticker{border:2px solid #2A1A12;border-radius:16px;background:#FFFFFF;box-shadow:3px 3px 0 #2A1A12}
.nav{font:400 16px 'Lilita One',sans-serif;text-decoration:none;color:#2A1A12;padding:8px 14px;border-radius:999px;border:2px solid #2A1A12;background:#FFFFFF}
.day{height:52px;min-width:64px;padding:0 10px;border:2px solid #2A1A12;border-radius:12px;background:#FFFFFF;color:#2A1A12;font:400 12px 'Lilita One',sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer}
.tok{font:600 13px 'IBM Plex Mono',monospace;padding:5px 10px;border-radius:999px;background:#FFD447;border:1.5px solid #2A1A12;color:#2A1A12;text-decoration:none}
.row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 12px;min-height:44px}
.seg{flex:1;height:36px;border:0;border-radius:10px;font:700 12px 'Work Sans',sans-serif;cursor:pointer}
</style>
</helmet>
<div style="width: 100%; min-height: 960px; background: #FFFBF0; color: #2A1A12; font-family: 'Work Sans', sans-serif; box-sizing: border-box">
  <header style="background: repeating-linear-gradient(90deg, {{accent}} 0 28px, #FFFFFF 28px 56px); border-bottom: 3px solid #2A1A12">
    <div style="max-width: 1200px; margin: 0 auto; padding: 22px 24px; box-sizing: border-box; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px">
      <div class="sticker" style="padding: 10px 18px">
        <div class="lil" style="font-size: 34px; line-height: 1; color: {{accent}}">cine-tracker</div>
        <div style="font-size: 12px; font-weight: 700; margin-top: 4px">Mon, Oct 5 · near Astoria</div>
      </div>
      <nav aria-label="Main" style="display: flex; gap: 8px; flex-wrap: wrap">
        <a class="nav" href="H-Web.dc.html" style="background: #FFD447">Movies</a>
        <a class="nav" href="B-Theater.dc.html">Theaters</a>
        <a class="nav" href="B-Screenings.dc.html">Screenings</a>
        <button onClick="{{togglePrefs}}" aria-expanded="{{open}}" class="nav" style="cursor: pointer; display: flex; align-items: center; gap: 6px"><svg class="s" viewBox="0 0 24 24"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"></path><circle cx="16" cy="7" r="2"></circle><circle cx="10" cy="17" r="2"></circle></svg>Preferences</button>
      </nav>
    </div>
  </header>

  <div style="max-width: 1200px; margin: 0 auto; padding: 20px 24px 48px; box-sizing: border-box">
    <sc-if value="{{open}}" hint-placeholder-val="{{ false }}">
      <section aria-label="Preferences" class="sticker" style="padding: 16px; margin-bottom: 20px">
        <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap">
          <h2 class="lil" style="margin: 0; font-size: 22px">Preferences</h2>
          <button onClick="{{togglePrefs}}" style="height: 36px; padding: 0 14px; border: 2px solid #2A1A12; border-radius: 999px; background: #FFD447; color: #2A1A12; font: 700 13px 'Work Sans', sans-serif; cursor: pointer">Done</button>
        </div>
        <div style="font-size: 13px; font-weight: 700; margin: 12px 0 8px">Theater groups</div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 8px">
          <sc-for list="{{groups}}" as="g" hint-placeholder-count="5">
            <div class="row" style="border: 2px solid #2A1A12; border-radius: 12px">
              <div><div style="font-size: 14px; font-weight: 700">{{g.name}}</div><div style="font-size: 12px; color: #6B5A4E">{{g.sub}}</div></div>
              <button role="switch" aria-checked="{{g.on}}" aria-label="{{g.name}}" onClick="{{g.toggle}}" style="{{g.track}}"><span style="width: 20px; height: 20px; border-radius: 10px; background: #FFFFFF; border: 2px solid #2A1A12; display: block"></span></button>
            </div>
          </sc-for>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin-top: 14px">
          <div>
            <div style="font-size: 13px; font-weight: 700; margin-bottom: 8px">Showtime layout</div>
            <div style="padding: 3px; border: 2px solid #2A1A12; border-radius: 14px; display: flex; gap: 3px">
              <sc-for list="{{modes}}" as="m" hint-placeholder-count="3"><button class="seg" onClick="{{m.pick}}" style="{{m.style}}">{{m.label}}</button></sc-for>
            </div>
          </div>
          <div>
            <div style="font-size: 13px; font-weight: 700; margin-bottom: 8px">Seats</div>
            <div class="row" style="border: 2px solid #2A1A12; border-radius: 12px">
              <div style="font-size: 14px; font-weight: 700">Hide accessible-only showings</div>
              <button role="switch" aria-checked="{{seats.on}}" aria-label="Hide accessible-only showings" onClick="{{seats.toggle}}" style="{{seats.track}}"><span style="width: 20px; height: 20px; border-radius: 10px; background: #FFFFFF; border: 2px solid #2A1A12; display: block"></span></button>
            </div>
          </div>
        </div>
      </section>
    </sc-if>

    <main style="display: flex; flex-wrap: wrap; gap: 28px">
      <aside style="flex: 1 1 300px; min-width: 0">
        <h2 class="lil" style="margin: 0 0 12px; font-size: 24px">Playing tonight</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 14px">
          <sc-for list="{{movies}}" as="m" hint-placeholder-count="4">
            <a href="H-Web.dc.html" style="text-decoration: none; display: flex; flex-direction: column; gap: 8px">
              <span style="height: 170px; border-radius: 14px; border: 2px solid #2A1A12; background: {{m.color}}; display: flex; align-items: flex-end; padding: 10px; box-sizing: border-box; {{m.ring}}"><span class="lil" style="font-size: 18px; line-height: 1.05; color: #FFFFFF">{{m.title}}</span></span>
              <span style="font-size: 12px; font-weight: 700; color: #6B5A4E">{{m.meta}}</span>
            </a>
          </sc-for>
        </div>
      </aside>

      <section style="flex: 999 1 560px; min-width: 0">
        <div class="sticker" style="padding: 16px 18px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px">
          <div>
            <h1 class="lil" style="margin: 0; font-size: 38px; line-height: 1; color: {{accent}}">Harbor Lights</h1>
            <div style="font-size: 14px; font-weight: 600; margin-top: 6px">2h 14m · R · Drama · IMAX, Dolby, 70mm</div>
          </div>
          <button style="height: 44px; padding: 0 16px; border: 2px solid #2A1A12; border-radius: 999px; background: #FFD447; color: #2A1A12; font: 700 14px 'Work Sans', sans-serif; cursor: pointer; box-shadow: 2px 2px 0 #2A1A12">On watchlist</button>
        </div>

        <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 18px">
          <sc-for list="{{days}}" as="d" hint-placeholder-count="7">
            <button class="day" style="{{d.style}}"><span>{{d.dow}}</span><span class="mono" style="font-size: 15px; font-weight: 600">{{d.num}}</span></button>
          </sc-for>
        </div>

        <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; margin-top: 14px; font-size: 13px; font-weight: 600; color: #6B5A4E">
          <span>Next showing you can make, first · AMC, Regal, Alamo, local</span>
          <button onClick="{{togglePrefs}}" style="border: 0; background: transparent; padding: 8px 0; color: {{accent}}; font: 700 13px 'Work Sans', sans-serif; cursor: pointer">Theaters &amp; filters</button>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-top: 12px">
          <sc-for list="{{theaters}}" as="t" hint-placeholder-count="4">
            <div class="sticker" style="padding: 14px 16px; display: flex; flex-direction: column; gap: 8px">
              <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 8px">
                <a href="B-Theater.dc.html" style="font-size: 14px; font-weight: 700; text-decoration: none">{{t.name}}</a>
                <span style="font-size: 11px; font-weight: 700; color: #6B5A4E; flex: none">{{t.meta}}</span>
              </div>
              <div style="display: flex; align-items: center; gap: 12px">
                <span class="lil" style="font-size: 36px; line-height: 1; color: {{accent}}">{{t.next}}</span>
                <span style="display: flex; flex-direction: column"><span style="font-size: 13px; font-weight: 700">{{t.fmt}}</span><span style="font-size: 12px; color: #6B5A4E">{{t.wait}}</span></span>
              </div>
              <sc-if value="{{t.hasLater}}" hint-placeholder-val="{{ true }}">
                <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap"><span style="font-size: 12px; font-weight: 700; color: #6B5A4E">Later:</span><sc-for list="{{t.later}}" as="s" hint-placeholder-count="2"><a class="tok" href="H-Web.dc.html">{{s}}</a></sc-for></div>
              </sc-if>
              <sc-if value="{{t.hidden}}" hint-placeholder-val="{{ false }}"><div style="font-size: 12px; color: #6B5A4E; border-top: 2px dashed #E3D3B5; padding-top: 8px">{{t.hidden}}</div></sc-if>
            </div>
          </sc-for>
        </div>
      </section>
    </main>
  </div>
</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props='{"accent":{"editor":"color","default":"#D1301F","options":["#D1301F","#2457C5","#1E7F55"]},"showPrefs":{"editor":"boolean","default":false},"$preview":{"width":1280,"height":960}}'>
class Component extends DCLogic {
  renderVals() {
    const accent = this.props.accent ?? '#D1301F';
    const st = this.state || {};
    const open = st.prefs ?? (this.props.showPrefs ?? false);
    const off = st.off || { other: true };
    const mode = st.mode || 'theater';
    const seatsOn = st.seatsOff ? false : true;
    const track = (on) => 'width: 52px; height: 30px; flex: none; border: 2px solid #2A1A12; border-radius: 15px; padding: 1px; display: flex; align-items: center; cursor: pointer; justify-content: ' + (on ? 'flex-end' : 'flex-start') + '; background: ' + (on ? accent : '#EFE3CC');
    const groups = [
      { id: 'amc', name: 'AMC', sub: 'Shows A-List eligibility' },
      { id: 'regal', name: 'Regal', sub: 'Regal and UA theaters' },
      { id: 'alamo', name: 'Alamo Drafthouse', sub: 'Dine-in theaters' },
      { id: 'other', name: 'Other chains', sub: 'Cinemark, Showcase and more' },
      { id: 'local', name: 'Local & indie', sub: 'MoMI, Nitehawk, Metrograph' }
    ].map((g) => {
      const on = !off[g.id];
      return { ...g, on, track: track(on), toggle: () => this.setState({ off: { ...off, [g.id]: on } }) };
    });
    const modes = [['theater', 'By theater'], ['time', 'Time of day'], ['timeline', 'Timeline']].map((m) => ({
      label: m[1],
      style: m[0] === mode ? 'background: #FFD447; color: #2A1A12' : 'background: transparent; color: #6B5A4E',
      pick: () => this.setState({ mode: m[0] })
    }));
    const sel = 'background: ' + accent + '; color: #FFFFFF; box-shadow: 2px 2px 0 #2A1A12';
    const days = [['Mon', '5'], ['Tue', '6'], ['Wed', '7'], ['Thu', '8'], ['Fri', '9'], ['Sat', '10'], ['Sun', '11']].map((d, i) => ({ dow: d[0], num: d[1], style: i === 0 ? sel : '' }));
    const th = (name, meta, next, fmt, wait, later, hidden) => ({ name, meta, next, fmt, wait, later, hasLater: later.length > 0, hidden });
    return {
      accent,
      open,
      togglePrefs: () => this.setState({ prefs: !open }),
      groups,
      modes,
      seats: { on: seatsOn, track: track(seatsOn), toggle: () => this.setState({ seatsOff: seatsOn }) },
      days,
      movies: [
        { title: 'Harbor Lights', meta: '4 theaters · next 3:45', color: '#2E3F7A', ring: 'box-shadow: 4px 4px 0 ' + accent },
        { title: 'Night Ferry', meta: '3 theaters · next 4:20', color: '#7A2E2E', ring: '' },
        { title: 'Low Tide Motel', meta: '2 theaters · next 7:10', color: '#6B3A55', ring: '' },
        { title: 'Paper Moons', meta: '70mm · 7:30', color: '#3B5C4A', ring: '' }
      ],
      theaters: [
        th('AMC Lincoln Square 13', 'AMC · 3.1 mi', '3:45', 'IMAX · A-List', 'Starts in 1h 05m', ['7:00 Dolby', '10:15'], ''),
        th('Alamo Lower Manhattan', 'Alamo · 5.2 mi', '6:30', 'Standard', 'Starts in 3h 50m', ['9:45'], ''),
        th('Museum of the Moving Image', 'Local · 0.5 mi', '7:30', '70mm', 'Starts in 4h 50m', [], ''),
        th('Regal UA Kaufman Astoria', 'Regal · 0.6 mi', '7:40', 'RPX', 'Starts in 5h', [], '4:20 hidden: only wheelchair and companion seats left')
      ]
    };
  }
}
</script>
</body>
</html>